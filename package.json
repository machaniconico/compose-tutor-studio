{
  "name": "compose-tutor-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Education-integrated composition app: learn chords, scales, and song structure while making an 8-16 bar original song.",
  "scripts": {
    "dev": "pnpm --filter @cts/studio dev",
    "dev:desktop": "pnpm --filter @cts/studio dev:desktop",
    "check": "pnpm typecheck && pnpm test",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @cts/studio build:desktop",
    "check:release": "pnpm --filter @cts/studio check:release",
    "check:assets": "pnpm --filter @cts/studio check:assets",
    "check:privacy": "pnpm --filter @cts/studio check:privacy",
    "check:secrets": "pnpm --filter @cts/studio check:secrets",
    "check:size": "pnpm --filter @cts/studio check:size",
    "check:size:desktop": "pnpm --filter @cts/studio check:size:desktop",
    "release:archive": "pnpm --filter @cts/studio release:archive",
    "release:archive:verify": "pnpm --filter @cts/studio release:archive:verify",
    "release:gates:report": "pnpm --filter @cts/studio release:gates:report",
    "release:installers:smoke:plan": "pnpm --filter @cts/studio release:installers:smoke:plan",
    "release:installers:smoke:verify": "pnpm --filter @cts/studio release:installers:smoke:verify",
    "release:installers:verify": "pnpm --filter @cts/studio release:installers:verify",
    "release:manifest": "pnpm --filter @cts/studio release:manifest",
    "release:source-status": "pnpm --filter @cts/studio release:source-status",
    "release:source-status:verify": "pnpm --filter @cts/studio release:source-status:verify",
    "release:notices": "pnpm --filter @cts/studio release:notices",
    "release:notices:verify": "pnpm --filter @cts/studio release:notices:verify",
    "release:signing": "pnpm --filter @cts/studio release:signing",
    "release:signing:verify": "pnpm --filter @cts/studio release:signing:verify",
    "release:notes": "pnpm --filter @cts/studio release:notes",
    "release:notes:verify": "pnpm --filter @cts/studio release:notes:verify",
    "release:notes:verify:draft": "pnpm --filter @cts/studio release:notes:verify:draft",
    "release:qa-log": "pnpm --filter @cts/studio release:qa-log",
    "release:qa-log:verify": "pnpm --filter @cts/studio release:qa-log:verify",
    "release:qa-log:verify:draft": "pnpm --filter @cts/studio release:qa-log:verify:draft",
    "release:verify": "pnpm --filter @cts/studio release:verify",
    "release:verify:publish": "pnpm --filter @cts/studio release:verify:publish",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @cts/studio test:e2e",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
